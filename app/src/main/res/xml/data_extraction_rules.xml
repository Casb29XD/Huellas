<?xml version="1.0" encoding="utf-8"?>
<!--
   Ítem 35: en Android 12+ la transferencia entre dispositivos ignora allowBackup="false",
   así que la sesión de Supabase se excluye explícitamente en ambos modos.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="supabase_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="supabase_session.xml" />
    </device-transfer>
</data-extraction-rules>
