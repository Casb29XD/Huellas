# Secrets de las Edge Functions. En el hosted se configuran con:
#   supabase secrets set DEEPSEEK_API_KEY=... --project-ref <project-ref>
# Para `supabase functions serve` local copia este archivo a supabase/functions/.env (ignorado por git).
# SUPABASE_URL, SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY las inyecta Supabase; no las pongas aquí.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
