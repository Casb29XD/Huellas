# Copia este archivo a app/.env (ignorado por git) y completa los valores. Sin él la app arranca y muestra
# "Configura SUPABASE_URL". Nunca subas app/.env al repositorio.

# Proyecto Supabase (Dashboard > Project Settings > API):
#   hosted:  https://<project-ref>.supabase.co
#   local (supabase start), desde el emulador Android: http://10.0.2.2:54321
SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...) o, en proyectos antiguos, la anon key. NUNCA la service_role/secret.
SUPABASE_PUBLISHABLE_KEY=

# Google Maps SDK para Android (opcional en desarrollo; sin ella el mapa sale en gris)
MAPS_API_KEY=
