<?xml version="1.0" encoding="utf-8"?>
<!--
   Ítem 35: el access/refresh token de Supabase (supabase_session.xml) nunca viaja en el backup.
   allowBackup="false" en el manifest ya apaga el backup en la nube; esta exclusión cubre
   Android 11 o anterior si alguien vuelve a activarlo.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="supabase_session.xml" />
</full-backup-content>
